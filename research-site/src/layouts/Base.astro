---
interface Section { id: string; label: string }
interface Props {
  title: string;
  description?: string;
  sections?: Section[];
}
const { title, description = 'Investing research', sections = [] } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class={sections.length ? 'has-toc' : ''}>
    <header class="nav">
      <a class="brand" href="/">RESEARCH</a>
      <nav>
        <a href="/arm/" class={path.startsWith('/arm') ? 'active' : ''}>ARM</a>
        <a href="/disco/" class={path.startsWith('/disco') ? 'active' : ''}>DISCO</a>
      </nav>
    </header>

    {sections.length > 0 && (
      <nav class="toc" aria-label="页面目录">
        <p class="toc-title">目录</p>
        <ul>
          {sections.map((s, i) => (
            <li><a href={`#${s.id}`} data-target={s.id}><span class="toc-idx">{String(i + 1).padStart(2, '0')}</span>{s.label}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <slot />
    <footer class="footer">
      <div class="footer-inner">
        <p>个人研究整理 · 数据来自公开财报与披露 · 非投资建议</p>
        <p class="dim">最后更新 2026-07-28</p>
      </div>
    </footer>

    {sections.length > 0 && (
      <script is:inline>
        (function () {
          var links = document.querySelectorAll('.toc a[data-target]');
          if (!links.length || !('IntersectionObserver' in window)) return;
          var map = {};
          links.forEach(function (a) { map[a.getAttribute('data-target')] = a; });
          var current = null;
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                if (current) current.classList.remove('active');
                current = map[e.target.id];
                if (current) {
                  current.classList.add('active');
                  if (window.innerWidth < 1240) current.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
                }
              }
            });
          }, { rootMargin: '-25% 0px -65% 0px' });
          Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id);
            if (el) io.observe(el);
          });
        })();
      </script>
    )}
  </body>
</html>

<style is:global>
  :root {
    --bg: #000000;
    --ink: #f5f5f7;
    --ink-2: #b0b3b8;
    --ink-3: #6e7278;
    --line: #26282c;
    --accent: #4d8dd6;
    --up: #4fbf8b;
    --down: #d66a5a;
    --maxw: 1060px;
    --nav-h: 58px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.65;
  }
  a { color: inherit; text-decoration: none; }
  section[id] { scroll-margin-top: calc(var(--nav-h) + 52px); }

  /* ---------- top nav ---------- */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    height: var(--nav-h);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 36px;
    background: rgba(0,0,0,0.6);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .nav .brand { font-size: 13px; font-weight: 700; letter-spacing: 0.42em; }
  .nav nav a {
    font-size: 11.5px; font-weight: 500; letter-spacing: 0.26em;
    margin-left: 30px; color: var(--ink-2); text-transform: uppercase;
    padding-bottom: 3px; border-bottom: 1px solid transparent;
    transition: color .2s, border-color .2s;
  }
  .nav nav a:hover, .nav nav a.active { color: var(--ink); border-color: var(--ink); }

  /* ---------- toc ---------- */
  .toc { z-index: 90; }
  .toc .toc-title {
    font-size: 10px; letter-spacing: 0.4em; text-transform: uppercase;
    color: var(--ink-3); margin-bottom: 14px; font-weight: 600;
  }
  .toc ul { list-style: none; }
  .toc a {
    display: block; position: relative;
    font-size: 11.5px; letter-spacing: 0.14em; color: var(--ink-3);
    padding: 6px 0 6px 16px; white-space: nowrap;
    border-left: 1px solid var(--line);
    transition: color .2s, border-color .2s;
  }
  .toc .toc-idx { font-size: 9.5px; color: var(--ink-3); margin-right: 8px; letter-spacing: 0.1em; }
  .toc a:hover { color: var(--ink-2); }
  .toc a.active { color: var(--ink); border-left-color: var(--ink); font-weight: 500; }
  .toc a.active .toc-idx { color: var(--accent); }

  @media (min-width: 1240px) {
    .toc { position: fixed; left: 30px; top: 50%; transform: translateY(-50%); }
  }
  @media (max-width: 1239px) {
    .toc {
      position: fixed; top: var(--nav-h); left: 0; right: 0;
      display: flex; align-items: center;
      background: rgba(0,0,0,0.72);
      -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      padding: 0 14px;
    }
    .toc .toc-title { display: none; }
    .toc ul { display: flex; overflow-x: auto; scrollbar-width: none; }
    .toc ul::-webkit-scrollbar { display: none; }
    .toc li { flex: 0 0 auto; }
    .toc a { border-left: none; border-bottom: 2px solid transparent; padding: 10px 12px; }
    .toc a.active { border-bottom-color: var(--accent); }
    .toc .toc-idx { display: none; }
  }

  /* ---------- hero ---------- */
  .hero {
    min-height: 88vh; min-height: 88svh;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0 40px 7vh;
    position: relative;
  }
  .hero .kicker {
    font-size: 12px; letter-spacing: 0.46em; color: var(--ink-2);
    text-transform: uppercase; margin-bottom: 14px;
  }
  .hero h1 {
    font-size: clamp(48px, 8vw, 108px);
    font-weight: 700; letter-spacing: 0.06em; line-height: 1.0;
    text-transform: uppercase;
  }
  .hero .sub {
    margin-top: 18px; max-width: 620px;
    font-size: 15.5px; color: var(--ink-2); font-weight: 300;
  }
  .hero .scroll-hint {
    position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%);
    color: var(--ink-3); font-size: 10px; letter-spacing: 0.4em; text-transform: uppercase;
  }

  /* ---------- statbar ---------- */
  .statbar {
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .statbar .stat {
    padding: 26px 20px; border-right: 1px solid var(--line); text-align: center;
  }
  .statbar .stat:last-child { border-right: none; }
  .stat .num {
    font-size: clamp(28px, 3vw, 40px); font-weight: 200; letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums; line-height: 1.15;
  }
  .stat .num small { font-size: 0.45em; font-weight: 300; color: var(--ink-2); letter-spacing: 0.1em; }
  .stat .label {
    margin-top: 7px; font-size: 10px; letter-spacing: 0.28em;
    text-transform: uppercase; color: var(--ink-3);
  }

  /* ---------- sections ---------- */
  section.block { padding: 68px 40px 56px; }
  section.block.alt { background: #060708; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .inner { max-width: var(--maxw); margin: 0 auto; }
  .block .eyebrow {
    font-size: 11px; letter-spacing: 0.46em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 10px; font-weight: 600;
  }
  .block h2 {
    font-size: clamp(26px, 3.4vw, 38px); font-weight: 700;
    letter-spacing: 0.07em; text-transform: uppercase; line-height: 1.12;
    margin-bottom: 16px;
  }
  .block .lede { font-size: 15.5px; color: var(--ink-2); max-width: 780px; font-weight: 300; margin-bottom: 30px; }
  .block .lede strong, .block p strong { color: var(--ink); font-weight: 600; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: start; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
  @media (max-width: 880px) { .grid2 { grid-template-columns: 1fr; } }

  .card {
    border: 1px solid var(--line); padding: 20px 22px;
    background: rgba(255,255,255,0.015);
    transition: border-color .25s, background .25s;
  }
  .card:hover { border-color: #3a3d42; background: rgba(255,255,255,0.03); }
  .card h3 {
    font-size: 12.5px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--ink); margin-bottom: 10px; font-weight: 600;
  }
  .card p, .card li { font-size: 13.5px; color: var(--ink-2); font-weight: 300; }
  .card ul { list-style: none; }
  .card li { padding: 5.5px 0; border-bottom: 1px solid var(--line); }
  .card li:last-child { border-bottom: none; }
  .card li b { color: var(--ink); font-weight: 600; }

  /* ---------- tables ---------- */
  table.data {
    width: 100%; border-collapse: collapse; font-size: 13.5px;
    font-variant-numeric: tabular-nums;
  }
  table.data th {
    text-align: right; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink-3); font-weight: 600; padding: 9px 12px;
    border-bottom: 1px solid var(--ink-3);
  }
  table.data th:first-child, table.data td:first-child { text-align: left; }
  table.data td {
    padding: 8.5px 12px; text-align: right; color: var(--ink-2);
    border-bottom: 1px solid var(--line); font-weight: 300;
  }
  table.data td:first-child { color: var(--ink); font-weight: 500; }
  table.data tr.hl td { color: var(--ink); font-weight: 600; }
  table.data tbody tr { transition: background .15s; }
  table.data tbody tr:hover { background: rgba(255,255,255,0.03); }
  .table-scroll { overflow-x: auto; }
  .pos { color: var(--up) !important; }
  .neg { color: var(--down) !important; }

  /* ---------- charts ---------- */
  .chart-wrap { position: relative; width: 100%; height: 310px; margin-top: 14px; }
  .chart-wrap.short { height: 230px; }
  .chart-note { font-size: 11.5px; color: var(--ink-3); margin-top: 10px; font-weight: 300; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 16px; font-size: 11.5px; color: var(--ink-2); margin-top: 14px; }
  .legend span { display: flex; align-items: center; gap: 6px; letter-spacing: 0.05em; }
  .legend i { width: 10px; height: 10px; display: inline-block; }

  /* ---------- timeline ---------- */
  .timeline { border-left: 1px solid var(--line); margin-left: 6px; }
  .timeline .tl-item { position: relative; padding: 0 0 24px 30px; }
  .timeline .tl-item::before {
    content: ""; position: absolute; left: -5px; top: 8px;
    width: 9px; height: 9px; background: var(--bg);
    border: 1px solid var(--ink-2); border-radius: 50%;
  }
  .timeline .tl-item.major::before { background: var(--accent); border-color: var(--accent); }
  .tl-item .tl-date { font-size: 11px; letter-spacing: 0.28em; color: var(--accent); font-weight: 600; }
  .tl-item h4 { font-size: 15.5px; margin: 4px 0 3px; font-weight: 600; letter-spacing: 0.02em; }
  .tl-item p { font-size: 13.5px; color: var(--ink-2); font-weight: 300; max-width: 720px; }

  /* ---------- misc ---------- */
  .footer { border-top: 1px solid var(--line); padding: 32px 40px; }
  .footer-inner { max-width: var(--maxw); margin: 0 auto; font-size: 11.5px; letter-spacing: 0.1em; color: var(--ink-2); }
  .footer .dim { color: var(--ink-3); margin-top: 4px; }

  .srclist { font-size: 12.5px; color: var(--ink-2); font-weight: 300; }
  .srclist li { padding: 7px 0; border-bottom: 1px solid var(--line); list-style: none; }
  .srclist a { color: var(--accent); word-break: break-all; }
  .srclist a:hover { text-decoration: underline; }

  .callout {
    border-left: 2px solid var(--accent); padding: 13px 18px;
    background: rgba(77,141,214,0.06); margin: 20px 0;
    font-size: 13.5px; color: var(--ink-2); font-weight: 300;
  }
  .callout b { color: var(--ink); }
  .warn { border-left-color: var(--down); background: rgba(214,106,90,0.06); }

  ::selection { background: rgba(77,141,214,0.4); }

  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; }
  }

  /* ---------- content offset for fixed toc rail ---------- */
  @media (min-width: 1240px) {
    body.has-toc section.block, body.has-toc .hero { padding-left: 220px; padding-right: 60px; }
    body.has-toc .statbar { padding-left: 200px; }
  }

  /* ---------- tablet ---------- */
  @media (max-width: 900px) {
    .statbar { grid-template-columns: 1fr 1fr; }
    .statbar .stat { padding: 20px 14px; border-bottom: 1px solid var(--line); }
    .statbar .stat:nth-child(even) { border-right: none; }
    .statbar .stat:nth-child(n+3) { border-bottom: none; }
    section.block { padding: 56px 26px 46px; }
    .hero { padding: 0 26px 8vh; }
  }

  /* ---------- mobile ---------- */
  @media (max-width: 640px) {
    :root { --nav-h: 46px; }
    .nav { padding: 0 16px; }
    .nav .brand { font-size: 11.5px; letter-spacing: 0.32em; }
    .nav nav a { margin-left: 18px; font-size: 10.5px; letter-spacing: 0.18em; }

    .toc a { padding: 8px 10px; font-size: 11px; }

    .hero { padding: 0 18px 9vh; min-height: 86vh; min-height: 86svh; }
    .hero .kicker { font-size: 9.5px; letter-spacing: 0.3em; margin-bottom: 10px; }
    .hero h1 { font-size: clamp(42px, 14vw, 64px); }
    .hero .sub { font-size: 14px; margin-top: 13px; }
    .hero .scroll-hint { display: none; }

    .stat .num { font-size: 26px; }
    .stat .label { font-size: 9px; letter-spacing: 0.2em; }

    section.block { padding: 44px 18px 38px; }
    section[id] { scroll-margin-top: calc(var(--nav-h) + 46px); }
    .block h2 { font-size: 23px; letter-spacing: 0.05em; }
    .block .lede { font-size: 14px; margin-bottom: 24px; }
    .block .eyebrow { font-size: 10px; letter-spacing: 0.32em; }

    .grid2 { gap: 28px; }
    .grid3 { grid-template-columns: 1fr; gap: 10px; }
    .card { padding: 16px; }

    table.data { font-size: 12px; }
    table.data th { padding: 7px 7px; font-size: 9.5px; letter-spacing: 0.08em; }
    table.data td { padding: 7px 7px; }

    .chart-wrap { height: 240px; }
    .chart-wrap.short { height: 200px; }
    .legend { gap: 6px 12px; font-size: 10.5px; }

    .timeline .tl-item { padding: 0 0 20px 22px; }
    .tl-item h4 { font-size: 14.5px; }
    .tl-item p { font-size: 13px; }

    .callout { padding: 11px 13px; font-size: 12.5px; }
    .footer { padding: 26px 18px; }
    .footer-inner { font-size: 10.5px; }
  }
</style>

<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var targets = document.querySelectorAll('.block .inner > *, .statbar .stat, .card');
    if (!('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0 });
    targets.forEach(function (t) { t.classList.add('reveal'); io.observe(t); });
  })();
</script>
