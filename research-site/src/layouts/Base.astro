---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Investing research' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/">RESEARCH</a>
      <nav>
        <a href="/arm/" class={path.startsWith('/arm') ? 'active' : ''}>ARM</a>
        <a href="/disco/" class={path.startsWith('/disco') ? 'active' : ''}>DISCO</a>
      </nav>
    </header>
    <slot />
    <footer class="footer">
      <div class="footer-inner">
        <p>个人研究整理 · 数据来自公开财报与披露 · 非投资建议</p>
        <p class="dim">最后更新 2026-07-28</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #000000;
    --ink: #f5f5f7;
    --ink-2: #b0b3b8;
    --ink-3: #6e7278;
    --line: #26282c;
    --accent: #4d8dd6;
    --up: #4fbf8b;
    --down: #d66a5a;
    --maxw: 1120px;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.7;
  }
  a { color: inherit; text-decoration: none; }

  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 40px;
    background: rgba(0,0,0,0.55);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .nav .brand { font-size: 14px; font-weight: 700; letter-spacing: 0.42em; }
  .nav nav a {
    font-size: 12px; font-weight: 500; letter-spacing: 0.28em;
    margin-left: 34px; color: var(--ink-2); text-transform: uppercase;
    padding-bottom: 4px; border-bottom: 1px solid transparent;
    transition: color .2s, border-color .2s;
  }
  .nav nav a:hover, .nav nav a.active { color: var(--ink); border-color: var(--ink); }

  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0 40px 9vh;
    position: relative;
  }
  .hero .kicker {
    font-size: 13px; letter-spacing: 0.5em; color: var(--ink-2);
    text-transform: uppercase; margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(52px, 9vw, 128px);
    font-weight: 700; letter-spacing: 0.06em; line-height: 1.02;
    text-transform: uppercase;
  }
  .hero .sub {
    margin-top: 22px; max-width: 640px;
    font-size: 17px; color: var(--ink-2); font-weight: 300;
  }
  .hero .scroll-hint {
    position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
    color: var(--ink-3); font-size: 11px; letter-spacing: 0.4em; text-transform: uppercase;
  }

  .statbar {
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .statbar .stat {
    padding: 42px 28px; border-right: 1px solid var(--line); text-align: center;
  }
  .statbar .stat:last-child { border-right: none; }
  .stat .num {
    font-size: clamp(34px, 4vw, 52px); font-weight: 200; letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums; line-height: 1.15;
  }
  .stat .num small { font-size: 0.45em; font-weight: 300; color: var(--ink-2); letter-spacing: 0.1em; }
  .stat .label {
    margin-top: 10px; font-size: 11px; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--ink-3);
  }

  section.block { padding: 110px 40px 90px; }
  section.block.alt { background: #060708; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .inner { max-width: var(--maxw); margin: 0 auto; }
  .block .eyebrow {
    font-size: 12px; letter-spacing: 0.5em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 16px; font-weight: 600;
  }
  .block h2 {
    font-size: clamp(30px, 4.2vw, 48px); font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.15;
    margin-bottom: 26px;
  }
  .block .lede { font-size: 17px; color: var(--ink-2); max-width: 780px; font-weight: 300; margin-bottom: 44px; }
  .block .lede strong, .block p strong { color: var(--ink); font-weight: 600; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  @media (max-width: 880px) { .grid2 { grid-template-columns: 1fr; } }

  .card {
    border: 1px solid var(--line); padding: 28px;
    background: rgba(255,255,255,0.015);
  }
  .card h3 {
    font-size: 14px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--ink); margin-bottom: 14px; font-weight: 600;
  }
  .card p, .card li { font-size: 14.5px; color: var(--ink-2); font-weight: 300; }
  .card ul { list-style: none; }
  .card li { padding: 7px 0; border-bottom: 1px solid var(--line); }
  .card li:last-child { border-bottom: none; }
  .card li b { color: var(--ink); font-weight: 600; }

  table.data {
    width: 100%; border-collapse: collapse; font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  table.data th {
    text-align: right; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--ink-3); font-weight: 600; padding: 12px 14px;
    border-bottom: 1px solid var(--ink-3);
  }
  table.data th:first-child, table.data td:first-child { text-align: left; }
  table.data td {
    padding: 12px 14px; text-align: right; color: var(--ink-2);
    border-bottom: 1px solid var(--line); font-weight: 300;
  }
  table.data td:first-child { color: var(--ink); font-weight: 500; }
  table.data tr.hl td { color: var(--ink); font-weight: 600; }
  .table-scroll { overflow-x: auto; }
  .pos { color: var(--up) !important; }
  .neg { color: var(--down) !important; }

  .chart-wrap { position: relative; width: 100%; height: 360px; margin-top: 18px; }
  .chart-wrap.short { height: 260px; }
  .chart-note { font-size: 12px; color: var(--ink-3); margin-top: 12px; font-weight: 300; }
  .legend { display: flex; flex-wrap: wrap; gap: 18px; font-size: 12px; color: var(--ink-2); margin-top: 20px; }
  .legend span { display: flex; align-items: center; gap: 7px; letter-spacing: 0.06em; }
  .legend i { width: 11px; height: 11px; display: inline-block; }

  .timeline { border-left: 1px solid var(--line); margin-left: 6px; }
  .timeline .tl-item { position: relative; padding: 0 0 34px 34px; }
  .timeline .tl-item::before {
    content: ""; position: absolute; left: -5px; top: 9px;
    width: 9px; height: 9px; background: var(--bg);
    border: 1px solid var(--ink-2); border-radius: 50%;
  }
  .timeline .tl-item.major::before { background: var(--accent); border-color: var(--accent); }
  .tl-item .tl-date { font-size: 12px; letter-spacing: 0.3em; color: var(--accent); font-weight: 600; }
  .tl-item h4 { font-size: 17px; margin: 6px 0 4px; font-weight: 600; letter-spacing: 0.02em; }
  .tl-item p { font-size: 14px; color: var(--ink-2); font-weight: 300; max-width: 720px; }

  .footer { border-top: 1px solid var(--line); padding: 46px 40px; }
  .footer-inner { max-width: var(--maxw); margin: 0 auto; font-size: 12px; letter-spacing: 0.12em; color: var(--ink-2); }
  .footer .dim { color: var(--ink-3); margin-top: 6px; }

  .srclist { font-size: 13px; color: var(--ink-2); font-weight: 300; }
  .srclist li { padding: 8px 0; border-bottom: 1px solid var(--line); list-style: none; }
  .srclist a { color: var(--accent); word-break: break-all; }
  .srclist a:hover { text-decoration: underline; }

  .callout {
    border-left: 2px solid var(--accent); padding: 18px 24px;
    background: rgba(77,141,214,0.06); margin: 26px 0;
    font-size: 15px; color: var(--ink-2); font-weight: 300;
  }
  .callout b { color: var(--ink); }
  .warn { border-left-color: var(--down); background: rgba(214,106,90,0.06); }

  /* ---------- interactions & motion ---------- */
  table.data tbody tr { transition: background .15s; }
  table.data tbody tr:hover { background: rgba(255,255,255,0.03); }
  .card { transition: border-color .25s, background .25s; }
  .card:hover { border-color: #3a3d42; background: rgba(255,255,255,0.03); }

  .reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; }
  }

  ::selection { background: rgba(77,141,214,0.4); }

  /* ---------- tablet ---------- */
  @media (max-width: 900px) {
    .statbar { grid-template-columns: 1fr 1fr; }
    .statbar .stat { padding: 30px 18px; border-bottom: 1px solid var(--line); }
    .statbar .stat:nth-child(even) { border-right: none; }
    .statbar .stat:nth-child(n+3) { border-bottom: none; }
    section.block { padding: 84px 28px 70px; }
    .hero { padding: 0 28px 10vh; }
  }

  /* ---------- mobile ---------- */
  @media (max-width: 640px) {
    .nav { padding: 14px 18px; }
    .nav .brand { font-size: 12px; letter-spacing: 0.32em; }
    .nav nav a { margin-left: 20px; font-size: 11px; letter-spacing: 0.2em; }

    .hero { padding: 0 20px 11vh; min-height: 92vh; min-height: 92svh; }
    .hero .kicker { font-size: 10px; letter-spacing: 0.34em; margin-bottom: 12px; }
    .hero h1 { font-size: clamp(46px, 15vw, 72px); }
    .hero .sub { font-size: 14.5px; margin-top: 16px; }
    .hero .scroll-hint { display: none; }

    .stat .num { font-size: 30px; }
    .stat .label { font-size: 9.5px; letter-spacing: 0.22em; }

    section.block { padding: 64px 20px 56px; }
    .block h2 { font-size: 26px; letter-spacing: 0.06em; }
    .block .lede { font-size: 15px; margin-bottom: 32px; }
    .block .eyebrow { font-size: 10.5px; letter-spacing: 0.36em; }

    .grid2 { gap: 36px; }
    .grid3 { grid-template-columns: 1fr; gap: 14px; }
    .card { padding: 20px 18px; }

    table.data { font-size: 12.5px; }
    table.data th { padding: 9px 8px; font-size: 10px; letter-spacing: 0.1em; }
    table.data td { padding: 9px 8px; }

    .chart-wrap { height: 260px; }
    .chart-wrap.short { height: 220px; }
    .legend { gap: 10px 14px; font-size: 11px; }

    .timeline .tl-item { padding: 0 0 26px 24px; }
    .tl-item h4 { font-size: 15.5px; }
    .tl-item p { font-size: 13.5px; }

    .callout { padding: 14px 16px; font-size: 13.5px; }
    .footer { padding: 34px 20px; }
    .footer-inner { font-size: 11px; }
  }
</style>

<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var targets = document.querySelectorAll('.block .inner > *, .statbar .stat, .card');
    if (!('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0 });
    targets.forEach(function (t) { t.classList.add('reveal'); io.observe(t); });
  })();
</script>
